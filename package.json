{
  "name": "@ngotaico/mcp-codebase-index",
  "version": "1.6.1-beta.9",
  "description": "MCP server for AI-powered codebase indexing with semantic memory, smart bootstrap, and intelligent context compilation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-codebase-index": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test",
    "test:todo1": "tsx test/todo-tests/todo1-parallel-embedding.test.ts",
    "test:todo2": "tsx test/todo-tests/todo2-entity-validation.test.ts",
    "test:todo3": "tsx test/todo-tests/todo3-orphaned-cleanup.test.ts",
    "test:todo4": "tsx test/todo-tests/todo4-autosync.test.ts",
    "test:todo5": "tsx test/todo-tests/todo5-batch-retrieve.test.ts",
    "test:todo6": "tsx test/todo-tests/todo6-truncation-warnings.test.ts",
    "test:todo7": "tsx test/todo-tests/todo7-retry-logic.test.ts",
    "test:todo8": "tsx test/todo-tests/todo8-collection-verification.test.ts",
    "test:todo8-integration": "tsx test/todo-tests/todo8-integration.test.ts",
    "test:todo9": "tsx test/todo-tests/todo9-clear-on-bootstrap.test.ts",
    "test:todo10": "tsx test/todo-tests/todo10-progress-feedback.test.ts",
    "test:flow1": "tsx test/memory-flow/test-flow-1-bootstrap.test.ts",
    "test:flow2": "tsx test/memory-flow/test-flow-2-search.test.ts",
    "test:perf": "tsx test/memory-flow/test-performance-latency.test.ts",
    "test:integration": "tsx test/memory-flow/test-integration-mcp-tools.test.ts",
    "test:dual-search": "tsx test/memory-flow/test-integration-dual-search.test.ts",
    "test:memory": "npm run test:flow1 && npm run test:flow2 && npm run test:perf",
    "inspector": "npx @modelcontextprotocol/inspector node ./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "mcpName": "io.github.ngotaico/codebase-index",
  "keywords": [
    "mcp",
    "mcp-server",
    "code-indexing",
    "qdrant",
    "gemini",
    "semantic-search",
    "vector-search",
    "codebase-search"
  ],
  "author": "ngotaico",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NgoTaiCo/mcp-codebase-index.git"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "umap-js": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}